# ──────────────────────────────────────────────────────────────────────
#
# Your Laptop's Touchpad Toggle
#
# ──────────────────────────────────────────────────────────────────────
#
# Purpose   Toggle touchpad enable/disable on GNOME/Wayland systems.
#           Includes CLI management for status checks and installation.
#           See help for overview and documentation for details.
#
# Author    Copyright (c) 2026 RML Tec Dev
#           Contributions and feedback are welcome via rmltecdev@pm.me
#
# License   Licensed under the MIT License
#
# ──────────────────────────────────────────────────────────────────────
#
# Localization:
# [DE] Deutsch, generiscb
# Stellen Sie sicher, dass sich die Sprachdateien im selben Verzeichnis
# wie das Skript befinden.
#
# ──────────────────────────────────────────────────────────────────────



# man-page style help
read -r -d '' MSG_HELP_TEXT <<EOF
NAME
    Touchpad Toggle
    Der Touchpad-Umschalter für Ihren Laptop (Touchpad Toggle)

BESCHREIBUNG
    Aktivieren/Deaktivieren des Touchpads unter GNOME/Wayland, um
    versehentliche Mauszeigerbewegungen zu verhindern, die zu
    unabsichtlicher Markierung und Überschreiben von Text führen.

UMGEBUNG
    Linux mit GNOME Desktop Umgebung und Wayland Display Server.

ANFORDERUNGEN
    Audiowiedergabe (ALSA, PipeWire, PulseAudio) wird zur Laufzeit
    erkannt. Systemklänge zum Deaktivieren und Aktivieren des Touchpads.

KONFIGURATION
    Standard-Tastenkombination  ${KEY_BINDING}

NUTZUNG
    ${SCRIPT_NAME} [OPTION]

    OPTIONEN
        (ohne/ungültig)  Aktuellen Status und Tastenkombination anzeigen
        --assign         Permanente Tastenkombination zuweisen.
        --help           Diese Hilfe anzeigen.
        --mouse-mode     Mausmodus aktivieren/deaktivieren
        --reset          Eingabe-Subsystem zurücksetzen; erhöhte
                         Privilegien erforderlich.
        --toggle         Touchpad aktivieren/deaktivieren.
        --unassign       Tastenkombination entfernen.
        --version        Versions-Metadaten anzeigen.
        --watch          ${SCRIPT_NAME} überwachen; wird alle ${WATCH_INTERVAL} 
                         Sekunden aktualisiert; mit Strg+C beenden.

AUTOR
    Copyright (c) 2026 RML Tec Dev
    Beiträge und Feedback sind unter rmltecdev@pm.me willkommen.

HAFTUNGSAUSSCHLUSS
    Dieses Skript wird ohne jegliche Gewährleistung bereitgestellt. Die
    Nutzung erfolgt auf eigene Gefahr.
    Testen Sie das Skript gründlich; das Touchpad Ihres Laptops kann 
    unerwartet nicht mehr reagieren.

LIZENZ
    Lizenziert unter der MIT-Lizenz.
EOF

# Mathematically inflate padding to align with longest string
INFO_PAD="%-17s"

# Associative array to map keys to localized strings
MSG[assign_abort_msg]="  Dem Touchpad-Umschalter wurde bereits eine Tastenkombination zugewiesen.\n  Rufen Sie das Skript ohne Option auf, um Informationen zu erhalten."
MSG[assign_abort_title]="Zuweisen der Tastenkombination abgebrochen."
MSG[assign_instructions]="Falls die Tastenkombination die Funktion des Touchpads nicht beim ersten\nVersuch umschaltet, ist sie möglicherweise bereits einer anderen\nAnwendung zugewiesen. Bitte wählen Sie eine andere Tastenkombination."
MSG[assign_preparing]="Bereite Zuweisung der Tastenkombination vor..."
