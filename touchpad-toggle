# ───── Error handling ─────────────────────────────────────────────────

# Intentionally disabled for GRACEFUL error handling.
# Uncomment to enable STRICT error handling.
#set -euo pipefail



# ───── Variables declaration ──────────────────────────────────────────

# App Title
APP_TITLE="≡ Touchpad Toggle ≡"

# Version Metadata
VERSION="1.1.2"
BUILD_DATE="2026-08-13"

# Global Environment
export PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin

# Configuration
KEY_BINDING="<Super>q"
WATCH_INTERVAL="2"

# User specific sounds
TOUCHPAD_DISABLED="/usr/share/sounds/zorin/stereo/device-removed.oga"
TOUCHPAD_ENABLED="/usr/share/sounds/zorin/stereo/device-added.oga"

# Environment
GSETTINGS_SCHEMA="org.gnome.desktop.peripherals.touchpad"
GSETTINGS_KEY="send-events"
MEDIA_KEYS_SCHEMA="org.gnome.settings-daemon.plugins.media-keys"
SCRIPT_PATH=$(realpath -s "$0")    # realpath -s: Returns absolute path but DOES NOT resolve symlinks.
SCRIPT_DIR="$(dirname "$SCRIPT_PATH")"
SCRIPT_NAME="$(basename "$SCRIPT_PATH")"

# Logging
LOG_DIR="${XDG_STATE_HOME:-$HOME/.local/state}"
RUNTIME_LOG="$LOG_DIR/$SCRIPT_NAME.log"

# Status Indicators
INDICATOR_FAIL="\033[31m■ "
INDICATOR_CRIT="\033[1;31m◆ "
INDICATOR_WARN="\033[93m▲ "
INDICATOR_PASS="\033[32m● "
INDICATOR_INFO="\033[1;34m● "

# Formatting
FORMATTING_RESET="\033[0m"
FORMATTING_BOLD="\033[1m"
FORMATTING_HEADER="\033[1;34m"



# ───── Logging ────────────────────────────────────────────────────────

log() {
    [[ -d "$LOG_DIR" ]] || mkdir -p "$LOG_DIR"
    printf "[%s] [%s, v%s] %s\n" "$(date '+%Y-%m-%d %H:%M:%S')" "$SCRIPT_NAME" "$VERSION" "$1" >> "$RUNTIME_LOG"
}



# ───── Show Header ────────────────────────────────────────────────────

show_header() {
    printf "\n%b%b%b\n\n" "${FORMATTING_HEADER}" "${APP_TITLE}" "${FORMATTING_RESET}"
}



# ───── Localization ───────────────────────────────────────────────────

# Detect system language (default to 'en' if detection fails)
declare -A MSG
SYSTEM_LANG="${LANG:0:2}"

# Declare Languages Dictionary
LOCALE_FILE="${SCRIPT_DIR}/${SCRIPT_NAME}.${SYSTEM_LANG}"
FALLBACK_FILE="${SCRIPT_DIR}/${SCRIPT_NAME}.en"

if [[ -f "$LOCALE_FILE" ]]; then
    # shellcheck disable=SC1090
    source "$LOCALE_FILE"
elif [[ -f "$FALLBACK_FILE" ]]; then
    # shellcheck disable=SC1090
    source "$FALLBACK_FILE"
else
    show_header
    printf "\n%b%b%b\n" "$INDICATOR_FAIL" "Localization error" "${FORMATTING_RESET}"
    printf "  Missing fallback file %s.\n" "$FALLBACK_FILE"
    printf "  Ensure language files are in same directory as script.\n\n"
    log "■ Localization failed."
    exit 1
fi



# ───── Man Page Style Help Viewer ─────────────────────────────────────

show_help() {
    echo "${MSG[help_open]}" 
    log "● Opening help..."
    echo "${MSG[help_text]}" | less
    echo "${MSG[help_close]}"
    log "● Help closed."
    exit 0
}



# ───── Detect Audio System ────────────────────────────────────────────

detect_audio_system() {
    # 1. Detect audio player
    if [[ -z "${AUDIO_PLAYER:-}" || ! -x "${AUDIO_PLAYER}" ]]; then
        if command -v pw-play &>/dev/null; then
            AUDIO_PLAYER="$(command -v pw-play)"
        elif command -v paplay &>/dev/null; then
            AUDIO_PLAYER="$(command -v paplay)"
        elif command -v aplay &>/dev/null; then
            AUDIO_PLAYER="$(command -v aplay)"
        else
            printf "%b%b%s%b\n" "${INDICATOR_FAIL}" "${FORMATTING_RESET}" \
                "${MSG[error_no_audio]}" "${FORMATTING_RESET}" >&2
            printf "  %b\n" "${MSG[install_hint]}"
            log "◆ No audio system detected."
            return 1
        fi
    fi

    # 2. Detect sound files — only if current paths don't exist
    if [[ -f "${TOUCHPAD_DISABLED:-}" && -f "${TOUCHPAD_ENABLED:-}" ]]; then
        return 0  # Already configured and valid, skip detection
    fi

    local -a sound_paths=(
        "/usr/share/sounds/freedesktop/stereo"
        "/usr/share/sounds/ubuntu/stereo"
        "/usr/share/sounds/zorin/stereo"
        "$HOME/.local/share/sounds/freedesktop/stereo"
    )

    local found=false
    for dir in "${sound_paths[@]}"; do
        if [[ -f "$dir/device-removed.oga" && -f "$dir/device-added.oga" ]]; then
            TOUCHPAD_DISABLED="$dir/device-removed.oga"
            TOUCHPAD_ENABLED="$dir/device-added.oga"
            found=true
            break
        elif [[ -f "$dir/complete.oga" ]]; then
            TOUCHPAD_DISABLED="$dir/complete.oga"
            TOUCHPAD_ENABLED="$dir/complete.oga"
            found=true
            break
        fi
    done

    if [[ "$found" = false ]]; then
        printf "%b%b%s%b\n" "${INDICATOR_WARN}" "${FORMATTING_RESET}" \
            "${MSG[warn_no_sound]}" "${FORMATTING_RESET}"
        printf "  %b\n" "${MSG[warn_no_sound_hint]}"
        AUDIO_PLAYER=""
    fi

    return 0
}



# ───── Dependency Check ───────────────────────────────────────────────

check_dependencies() {
    local -a tools=("gsettings" "realpath")

    # Only check audio player if it was detected/set
    if [[ -n "${AUDIO_PLAYER:-}" ]]; then
        tools+=("${AUDIO_PLAYER%% *}")
    fi

    for tool in "${tools[@]}"; do
        if ! command -v "$tool" &> /dev/null; then
            tool_name="${tool##*/}"
            printf "%b%b%b %b%b%s%b\n\n" "${APP_TITLE}" "${INDICATOR_FAIL}" "${FORMATTING_RESET}" \
                "${MSG[error_tool]}" "${FORMATTING_BOLD}" "$tool_name" "${FORMATTING_RESET}" >&2
            printf "  %b %b%b%s%b\n\n" "${APP_TITLE}" "${MSG[install_hint]}" \
                "${FORMATTING_BOLD}" "$tool_name" "${FORMATTING_RESET}"
            log "■ Dependencies missing."
            exit 1
        fi
    done
}



# ───── Get Current Touchpad State ─────────────────────────────────────

get_current_state() {
    gsettings get "${GSETTINGS_SCHEMA}" "${GSETTINGS_KEY}"
}



# ───── Toggle Touchpad ────────────────────────────────────────────────

toggle_touchpad() {
    # A 200ms execution buffer prevents the libinput race condition 
    # (n=n+1 gesture bug). It allows physical keystrokes (Super+Q) and
    # palm resting events to clear the event queue, ensuring libinput is
    # in a neutral state before the DBus state change severs the event 
    # stream.
    sleep 0.2

    local current_state
    current_state=$(get_current_state)
    
    if [ "${current_state}" = "'enabled'" ]; then
        gsettings set "${GSETTINGS_SCHEMA}" "${GSETTINGS_KEY}" "'disabled'"
        "${AUDIO_PLAYER}" "${TOUCHPAD_DISABLED}" &
        log "▲ Touchpad disabled."
    else
        gsettings set "${GSETTINGS_SCHEMA}" "${GSETTINGS_KEY}" "'enabled'"
        "${AUDIO_PLAYER}" "${TOUCHPAD_ENABLED}" 
        log "● Touchpad enabled."
    fi

    check_state
    check_shortcut
    echo
}



# ───── Check Touchpad Status ──────────────────────────────────────────

check_state() {
    local state
    state=$(get_current_state)
    if [ "${state}" = "'enabled'" ]; then
        printf "$INFO_PAD   %b%b%b%b\n" "${MSG[info_status_label]}" "${INDICATOR_PASS}" "${MSG[info_enabled]}" "${FORMATTING_RESET}"
    else
        printf "$INFO_PAD   %b%b%b%b\n" "${MSG[info_status_label]}" "${INDICATOR_CRIT}" "${MSG[info_disabled]}" "${FORMATTING_RESET}"
    fi
}



# ───── Keyboard Shortcut Management ───────────────────────────────────

# Check Keyboard Shortcut

check_shortcut() {
    # Returns exit code 0 (success) if found, exit code 1 (failure) if not found.
    # Also prints status to stdout.
    local binding_list
    binding_list=$(gsettings get "${MEDIA_KEYS_SCHEMA}" custom-keybindings)

    # Clean the list format to iterate
    local paths
    paths=$(echo "${binding_list}" | tr -d "[]'," | tr "," " ")

    for path in ${paths}; do
        # Get the command associated with this custom binding
        local cmd
        cmd=$(gsettings get "org.gnome.settings-daemon.plugins.media-keys.custom-keybinding:${path}" command 2>/dev/null)

        # Check if the command matches OUR script path exactly
        if [[ "${cmd}" == *"${SCRIPT_PATH}"* ]]; then
            local current_binding
            current_binding=$(gsettings get "org.gnome.settings-daemon.plugins.media-keys.custom-keybinding:${path}" binding)

            # Localized Output
            printf "$INFO_PAD   %b%b%b → %b%b%b\n" "${MSG[check_status_label]}" "${INDICATOR_PASS}" "${MSG[check_assign]}" "${FORMATTING_RESET}" "${FORMATTING_BOLD}" "${current_binding}" "${FORMATTING_RESET}"
            log "● Keyboard shortcut assigned."
            return 0
        fi
    done

    # Localized Output
    printf "%s   %b%s%b\n" "${MSG[check_status_label]}" "${INDICATOR_FAIL}" "${MSG[check_not_detected]}" "${FORMATTING_RESET}"
    printf "%s\n" "${MSG[check_invoke_hint]}"
    log "■ Keyboard shortcut not detected"
    return 1
}


# Remove Keyboard Shortcut

remove_shortcut() {

    printf "%b%s%b\n" "${FORMATTING_BOLD}" "${MSG[keyb_manager]}" "${FORMATTING_RESET}"

    # Localized Output
    printf "%b%b%s\n\n" "${INDICATOR_INFO}" "${FORMATTING_RESET}" "${MSG[rem_preparing]}"

    # 1. Find the specific path associated with THIS script
    local binding_list
    binding_list=$(gsettings get "${MEDIA_KEYS_SCHEMA}" custom-keybindings)
    local paths
    paths=$(echo "${binding_list}" | tr -d "[]'," | tr "," " ")

    local path_to_remove=""

    for path in ${paths}; do
        local cmd
        cmd=$(gsettings get "org.gnome.settings-daemon.plugins.media-keys.custom-keybinding:${path}" command 2>/dev/null)

        if [[ "${cmd}" == *"${SCRIPT_PATH}"* ]]; then
            path_to_remove="${path}"
            local current_binding
            current_binding=$(gsettings get "org.gnome.settings-daemon.plugins.media-keys.custom-keybinding:${path}" binding)

            # Localized Output
            printf "%b%b%s %b%b%b\n" "${INDICATOR_INFO}" "${FORMATTING_RESET}" "${MSG[rem_found]}" "${FORMATTING_BOLD}" "${current_binding}" "${FORMATTING_RESET}"
            break
        fi
    done

    # 2. Safety check
    if [ -z "${path_to_remove}" ]; then
        # Localized Output
        printf "%b%b%b\n" "${INDICATOR_WARN}" "${MSG[rem_not_found]}" "${FORMATTING_RESET}"
        printf "  %s\n\n" "${MSG[rem_nothing]}"
        return 1
    fi

    # 3. Rebuild the list EXCLUDING the path to remove
    local new_list="["
    local is_first=true

    for path in ${paths}; do
        if [ "${path}" != "${path_to_remove}" ]; then
            if [ "${is_first}" = true ]; then
                new_list="${new_list}'${path}'"
                is_first=false
            else
                new_list="${new_list}, '${path}'"
            fi
        fi
    done
    new_list="${new_list}]"

    if [ "${new_list}" == "[]" ]; then
        new_list="@as []"
    fi

    # 4. Apply changes
    gsettings set "${MEDIA_KEYS_SCHEMA}" custom-keybindings "${new_list}"
    gsettings reset-recursively "org.gnome.settings-daemon.plugins.media-keys.custom-keybinding:${path_to_remove}"
    #gsettings set org.gnome.mutter.keybindings switch-monitor "@as []"
    
    # Localized Output
    printf "%b%b%b\n\n" "${INDICATOR_PASS}" "${FORMATTING_RESET}" "${MSG[rem_success]}"
    log "◆ Keyboard shortcut removed."
}


# Assign Keyboard Shortcut 

assign_shortcut() {

    printf "%b%s%b\n" "${FORMATTING_BOLD}" "${MSG[keyb_manager]}" "${FORMATTING_RESET}"

    # Localized Output
    printf "%b%b%s\n\n" "${INDICATOR_INFO}" "${FORMATTING_RESET}" "${MSG[assign_preparing]}"

    if check_shortcut > /dev/null; then
        # Localized Output
        printf "%b%b%b\n" "${INDICATOR_WARN}" "${MSG[assign_abort_title]}" "${FORMATTING_RESET}"
        printf "%b\n" "${MSG[assign_abort_msg]}"
        return
    fi

    local timestamp
    timestamp=$(date +%s)
    local new_path="/org/gnome/settings-daemon/plugins/media-keys/custom-keybindings/custom-touchpad-toggle-${timestamp}/"

    local current_list
    current_list=$(gsettings get "${MEDIA_KEYS_SCHEMA}" custom-keybindings)

    local new_list=""
    if [ "${current_list}" = "@as []" ]; then
        new_list="['${new_path}']"
    else
        new_list="${current_list%]}, '${new_path}']"
    fi

    gsettings set "${MEDIA_KEYS_SCHEMA}" custom-keybindings "${new_list}"

    # Use localized name for the GNOME Settings GUI
    gsettings set org.gnome.mutter.keybindings switch-monitor "@as []"
    gsettings set "org.gnome.settings-daemon.plugins.media-keys.custom-keybinding:${new_path}" name "${SCRIPT_NAME^}"
    gsettings set "org.gnome.settings-daemon.plugins.media-keys.custom-keybinding:${new_path}" command "${SCRIPT_PATH} --toggle"
    gsettings set "org.gnome.settings-daemon.plugins.media-keys.custom-keybinding:${new_path}" binding "${KEY_BINDING}"

    # Localized Output
    printf "%b%b%s %b%b%b\n" "${INDICATOR_PASS}" "${FORMATTING_RESET}" "${MSG[assign_success]}" "${FORMATTING_BOLD}" "${KEY_BINDING}" "${FORMATTING_RESET}"
    printf "%b\n\n" "${MSG[assign_instructions]}"
    log "● Keyboard shortcut ${KEY_BINDING} assigned."
}



# ───── Reset Input Subsystem ──────────────────────────────────────────

reset_input_subsystem() {
    # 1. Confirm user intent
    printf "%b%b%s%b\n\n" "${INDICATOR_WARN}" "${FORMATTING_RESET}" \
        "${MSG[reset_confirm_warning]}" "${FORMATTING_RESET}"
    printf "  %s" "${MSG[reset_confirm_prompt]}"
    
    read -r response
    case "$response" in
        [YyJj]*)
            # Continue
            ;;
        *)
            printf "\n%b%b%s%b\n\n" "${INDICATOR_INFO}" "${FORMATTING_RESET}" \
                "${MSG[reset_aborted]}" "${FORMATTING_RESET}"
            return 1
            ;;
    esac

    # 2. Validate sudo availability
    if ! sudo -n true 2>/dev/null; then
        printf "\n%b%b%s%b\n" "${INDICATOR_WARN}" "${FORMATTING_RESET}" \
            "${MSG[sudo_required]}" "${FORMATTING_RESET}"
        exit 1
    fi

    # 3. Execute reset
    printf "%b%s%b\n" "${INDICATOR_INFO}" "${MSG[reset_preparing]}" "${FORMATTING_RESET}"
    if sudo udevadm trigger -s input; then
        printf "\n%b%b%s\n\n" "${INDICATOR_PASS}" "${FORMATTING_RESET}" "${MSG[reset_success]}"
        log "Input reset successful."
    else
        printf "\n%b%b%s\n\n" "${INDICATOR_FAIL}" "${FORMATTING_RESET}" "${MSG[reset_fail]}"
        log "■ Input subsystem reset failed."
        exit 1
    fi
}



# ───── Display Status and Config Information ──────────────────────────

display_info() {

    check_state
    check_shortcut

    printf "\n%b\n" "${MSG[info_invoke]}"
    printf "├ $INFO_PAD %s %b%b%b\n" "--assign" "${MSG[info_desc_assign]}" "${FORMATTING_BOLD}" "${KEY_BINDING}" "${FORMATTING_RESET}"
    printf "├ $INFO_PAD %s%b\n" "--help" "${MSG[info_desc_help]}"
    printf "├ $INFO_PAD %s%b\n" "--reset" "${MSG[info_desc_reset]}"  
    printf "├ $INFO_PAD %s%b\n" "--toggle" "${MSG[info_desc_toggle]}"
    printf "├ $INFO_PAD %s%b\n" "--unassign" "${MSG[info_desc_remove]}"
    printf "├ $INFO_PAD %s%b\n" "--version" "${MSG[info_desc_version]}"
    printf "╰ $INFO_PAD %s%b\n\n" "--watch" "${MSG[info_opt_watch]}"
    printf "  $INFO_PAD %b%b\n\n" "${MSG[info_path]}" "${SCRIPT_PATH}"    
}



# ───── Watch Script ───────────────────────────────────────────────────

watch_script() {
    printf "%b" "${MSG[watch_start]}"
    log "● Watching script…"
    watch --no-wrap --color --interval "$WATCH_INTERVAL" "$SCRIPT_PATH"
    printf "%b" "${MSG[watch_stop]}"
    log "● Script watching ended."
}



# ───── Show Version ───────────────────────────────────────────────────

show_version() {
    printf "  %-14s %s\n" "${MSG[info_version]}:" "$VERSION"
    printf "  %-14s %s\n" "${MSG[info_build_date]}:" "$BUILD_DATE"
    printf "  %-14s %s\n" "${MSG[info_path]}:" "$SCRIPT_PATH"
    log "● Script version showed."
    exit 0
}



# ───── Main Logic Execution ───────────────────────────────────────────

show_header
detect_audio_system || exit 1
check_dependencies


# Check which option is provided

case "$1" in
    --assign)   assign_shortcut       ;;
    --help)     show_help             ;;
    --reset)    reset_input_subsystem ;;
    --toggle)   toggle_touchpad       ;;
    --unassign) remove_shortcut       ;;
    --version)  show_version          ;;
    --watch)    watch_script          ;;
    *)          display_info
esac

exit 0

# End of script
