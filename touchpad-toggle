#
# Ensure language files are in same directory as script.
# Languages currently supported:
#   - [EN] English, generic (default fallback)
#   - [DE] German, generic 
#   - [TH] Thai
#
# ──────────────────────────────────────────────────────────────────



# ───── Error handling ─────────────────────────────────────────────

# Intentionally disabled for GRACEFUL error handling.
# Uncomment to enable STRICT error handling.
#set -euo pipefail



# ───── Variables declaration ──────────────────────────────────────

# Global Environment
export PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin

# Configuration
KEY_BINDING="<Super>p"

# Environment
TOUCHPAD_DISABLED="/usr/share/sounds/zorin/stereo/device-removed.oga"
TOUCHPAD_ENABLED="/usr/share/sounds/zorin/stereo/device-added.oga"
AUDIO_PLAYER="/usr/bin/pw-play"
GSETTINGS_SCHEMA="org.gnome.desktop.peripherals.touchpad"
GSETTINGS_KEY="send-events"
MEDIA_KEYS_SCHEMA="org.gnome.settings-daemon.plugins.media-keys"
DCONF_PATH="/org/gnome/desktop/peripherals/touchpad/send-events"
WATCH_INTERVAL="5"
SCRIPT_PATH=$(realpath -s "$0")    # realpath -s: Returns absolute path but DOES NOT resolve symlinks.
LOG_DIR="$HOME/.var/log"
RUNTIME_LOG="$LOG_DIR/touchpad-toggle.log"


# Status Indicators
INDICATOR_FAIL="\033[31m■ "
INDICATOR_CRIT="\033[1;31m◆ "
INDICATOR_WARN="\033[93m▲ "
INDICATOR_PASS="\033[32m● "
INDICATOR_INFO="\033[1;34m● "

# Formatting
FORMATTING_RESET="\033[0m"
FORMATTING_BOLD="\033[1m"
FORMATTING_HEADER="\033[1;34m"



# ───── Localization ───────────────────────────────────────────────

# Detect system language (default to 'en' if detection fails)
declare -A MSG
SYSTEM_LANG="${LANG:0:2}"
SCRIPT_DIR="$(dirname "$SCRIPT_PATH")"
SCRIPT_NAME="$(basename "$SCRIPT_PATH")"

# Declare Languages Dictionary
LOCALE_FILE="${SCRIPT_DIR}/${SCRIPT_NAME}.${SYSTEM_LANG}"
FALLBACK_FILE="${SCRIPT_DIR}/${SCRIPT_NAME}.en"

if [[ -f "$LOCALE_FILE" ]]; then
    source "$LOCALE_FILE"
elif [[ -f "$FALLBACK_FILE" ]]; then
    source "$FALLBACK_FILE"
else
    printf "\n%b%b%b\n" "${FORMATTING_HEADER}" ":: Battery Guardian ::" "${FORMATTING_RESET}"
    printf "\n%b%b%b%b\n" "$INDICATOR_FAIL" "$FORMATTING_BOLD" "Localization error" "${FORMATTING_RESET}"
    printf "  Missing fallback file '$FALLBACK_FILE'.\n"
    printf "  Ensure language files are in same directory as script.\n\n"
    exit 1
fi



# ───── Show Header ────────────────────────────────────────────────

show_header() {
    printf "\n%b%b%b\n\n" "${FORMATTING_HEADER}" "${MSG[header]}" "${FORMATTING_RESET}"
}



# ───── Man Page style help viewer ────────────────────────────────────────

show_help() {
    echo "${MSG[help_open]}" #| tee -a "$RUNTIME_LOG"
    echo "${MSG[help_text]}" | less
    echo "${MSG[help_close]}" #| tee -a "$RUNTIME_LOG"
    exit 0
}



# ───── Dependency Check ───────────────────────────────────────────

check_dependencies() {

    # Title for GNOME notifications
    notify_app_title="Touchpad Toggle"
    # Check for critical tools before proceeding.
    # We strip arguments from AUDIO_PLAYER to check just the binary name.
    for tool in gsettings notify-send "${AUDIO_PLAYER%% *}"; do
        if ! command -v "$tool" &> /dev/null; then
            # Strip the path to show only the binary name for the error message
            tool_name="${tool##*/}"
            printf "%b%b%b %b%s%b\n" "${notify_app_name}" "${INDICATOR_FAIL}" "${FORMATTING_RESET}" "${MSG[error_tool]}" "${FORMATTING_BOLD}" "$tool_name" "${FORMATTING_RESET}" >&2
            printf "  %b %b%b%b\n\n" "${notify_app_name}" "${MSG[install_hint]}" "${FORMATTING_BOLD}" "$tool_name" "${FORMATTING_RESET}"
            exit 1
        fi
    done
}



# ───── Get Current Touchpad State ─────────────────────────────────

get_current_state() {
    gsettings get "${GSETTINGS_SCHEMA}" "${GSETTINGS_KEY}"
}



# ───── Toggle Touchpad ────────────────────────────────────────────

toggle_touchpad() {
    # A 200ms execution buffer prevents the libinput race condition 
    # (n=n+1 gesture bug). It allows physical keystrokes (Super+Q) and
    # palm resting events to clear the event queue, ensuring libinput is
    # in a neutral state before the DBus state change severs the event stream.
    sleep 0.2

    local current_state
    current_state=$(get_current_state)
    local notif_hint="string:x-canonical-private-synchronous:touchpad-toggle"
    
    # Title for GNOME notifications
    notify_app_title="Touchpad Toggle"

    if [ "${current_state}" = "'enabled'" ]; then
        gsettings set "${GSETTINGS_SCHEMA}" "${GSETTINGS_KEY}" "'disabled'"
        "${AUDIO_PLAYER}" "${TOUCHPAD_DISABLED}" &
        notify-send -a "${notify_app_title}" -i touchpad-disabled-symbolic -h "${notif_hint}" "⚠️ ${MSG[notif_title]}" "${MSG[notif_disabled]}"
    else
        gsettings set "${GSETTINGS_SCHEMA}" "${GSETTINGS_KEY}" "'enabled'"
        "${AUDIO_PLAYER}" "${TOUCHPAD_ENABLED}" &
        notify-send -a "${notify_app_title}" -i input-touchpad-symbolic -h "${notif_hint}" "✅ ${MSG[notif_title]}" "${MSG[notif_enabled]}"
    fi

    check_state
    check_shortcut
    echo
}



# ───── Check Touchpad Status ──────────────────────────────────────

check_state() {
    local state
    state=$(get_current_state)
    if [ "${state}" = "'enabled'" ]; then
        printf "$INFO_PAD   %b%b%b%b\n" "${MSG[info_status_label]}" "${INDICATOR_PASS}" "${MSG[info_enabled]}" "${FORMATTING_RESET}"
    else
        printf "$INFO_PAD   %b%b%b%b\n" "${MSG[info_status_label]}" "${INDICATOR_CRIT}" "${MSG[info_disabled]}" "${FORMATTING_RESET}"
    fi
}



# ───── Keyboard Shortcut Management ───────────────────────────────

# Check Keyboard Shortcut

check_shortcut() {
    # Returns exit code 0 (success) if found, ext code 1 (failure) if not found.
    # Also prints status to stdout.
    local binding_list
    binding_list=$(gsettings get "${MEDIA_KEYS_SCHEMA}" custom-keybindings)

    # Clean the list format to iterate
    local paths
    paths=$(echo "${binding_list}" | tr -d "[]'," | tr "," " ")

    for path in ${paths}; do
        # Get the command associated with this custom binding
        local cmd
        cmd=$(gsettings get "org.gnome.settings-daemon.plugins.media-keys.custom-keybinding:${path}" command 2>/dev/null)

        # Check if the command matches OUR script path exactly
        if [[ "${cmd}" == *"${SCRIPT_PATH}"* ]]; then
            local current_binding
            current_binding=$(gsettings get "org.gnome.settings-daemon.plugins.media-keys.custom-keybinding:${path}" binding)

            # Localized Output
            printf "$INFO_PAD   %b%b%b → %b%b%b\n" "${MSG[check_status_label]}" "${INDICATOR_PASS}" "${MSG[check_assign]}" "${FORMATTING_RESET}" "${FORMATTING_BOLD}" "${current_binding}" "${FORMATTING_RESET}"
            return 0
        fi
    done

    # Localized Output
    printf "$INFO_PAD   %b%b%b\n" "${MSG[check_status_label]}" "${INDICATOR_FAIL}" "${MSG[check_not_detected]}" "${FORMATTING_RESET}"
    printf "$INFO_PAD   ${MSG[check_invoke_hint]}\n"
    printf " "
    return 1
}


# Remove Keyboard Shortcut

remove_shortcut() {

    printf "%b%s%b\n" "${FORMATTING_BOLD}" "${MSG[keyb_manager]}" "${FORMATTING_RESET}"

    # Localized Output
    printf "%b%b%s\n\n" "${INDICATOR_INFO}" "${FORMATTING_RESET}" "${MSG[rem_preparing]}"

    # 1. Find the specific path associated with THIS script
    local binding_list
    binding_list=$(gsettings get "${MEDIA_KEYS_SCHEMA}" custom-keybindings)
    local paths
    paths=$(echo "${binding_list}" | tr -d "[]'," | tr "," " ")

    local path_to_remove=""

    for path in ${paths}; do
        local cmd
        cmd=$(gsettings get "org.gnome.settings-daemon.plugins.media-keys.custom-keybinding:${path}" command 2>/dev/null)

        if [[ "${cmd}" == *"${SCRIPT_PATH}"* ]]; then
            path_to_remove="${path}"
            local current_binding
            current_binding=$(gsettings get "org.gnome.settings-daemon.plugins.media-keys.custom-keybinding:${path}" binding)

            # Localized Output
            printf "%b%b%s %b%b%b\n" "${INDICATOR_INFO}" "${FORMATTING_RESET}" "${MSG[rem_found]}" "${FORMATTING_BOLD}" "${current_binding}" "${FORMATTING_RESET}"
            break
        fi
    done

    # 2. Safety check
    if [ -z "${path_to_remove}" ]; then
        # Localized Output
        printf "%b%b%b\n" "${INDICATOR_WARN}" "${MSG[rem_not_found]}" "${FORMATTING_RESET}"
        printf "  %s\n\n" "${MSG[rem_nothing]}"
        return 1
    fi

    # 3. Rebuild the list EXCLUDING the path to remove
    local new_list="["
    local is_first=true

    for path in ${paths}; do
        if [ "${path}" != "${path_to_remove}" ]; then
            if [ "${is_first}" = true ]; then
                new_list="${new_list}'${path}'"
                is_first=false
            else
                new_list="${new_list}, '${path}'"
            fi
        fi
    done
    new_list="${new_list}]"

    if [ "${new_list}" == "[]" ]; then
        new_list="@as []"
    fi

    # 4. Apply changes
    gsettings set "${MEDIA_KEYS_SCHEMA}" custom-keybindings "${new_list}"
    gsettings reset-recursively "org.gnome.settings-daemon.plugins.media-keys.custom-keybinding:${path_to_remove}"
    #gsettings set org.gnome.mutter.keybindings switch-monitor "@as []"
    
    # Localized Output
    printf "%b%b%b\n\n" "${INDICATOR_PASS}" "${FORMATTING_RESET}" "${MSG[rem_success]}"
}


# Assign Keyboard Shortcut 

assign_shortcut() {

    printf "%b%s%b\n" "${FORMATTING_BOLD}" "${MSG[keyb_manager]}" "${FORMATTING_RESET}"

    # Localized Output
    printf "%b%b%s\n\n" "${INDICATOR_INFO}" "${FORMATTING_RESET}" "${MSG[assign_preparing]}"

    if check_shortcut > /dev/null; then
        # Localized Output
        printf "%b%b%b\n" "${INDICATOR_WARN}" "${MSG[assign_abort_title]}" "${FORMATTING_RESET}"
        printf "%b\n%s\n" "${MSG[assign_abort_msg]}"
        return
    fi

    local timestamp
    timestamp=$(date +%s)
    local new_path="/org/gnome/settings-daemon/plugins/media-keys/custom-keybindings/custom-touchpad-toggle-${timestamp}/"

    local current_list
    current_list=$(gsettings get "${MEDIA_KEYS_SCHEMA}" custom-keybindings)

    local new_list=""
    if [ "${current_list}" = "@as []" ]; then
        new_list="['${new_path}']"
    else
        new_list="${current_list%]}, '${new_path}']"
    fi

    gsettings set "${MEDIA_KEYS_SCHEMA}" custom-keybindings "${new_list}"

    # Use localized name for the GNOME Settings GUI
    gsettings set org.gnome.mutter.keybindings switch-monitor "@as []"
    gsettings set "org.gnome.settings-daemon.plugins.media-keys.custom-keybinding:${new_path}" name "${MSG[set_gnome_name]}"
    gsettings set "org.gnome.settings-daemon.plugins.media-keys.custom-keybinding:${new_path}" command "${SCRIPT_PATH} --toggle"
    gsettings set "org.gnome.settings-daemon.plugins.media-keys.custom-keybinding:${new_path}" binding "${KEY_BINDING}"

    # Localized Output
    printf "%b%b%s %b%b%b\n" "${INDICATOR_PASS}" "${FORMATTING_RESET}" "${MSG[assign_success]}" "${FORMATTING_BOLD}" "${KEY_BINDING}" "${FORMATTING_RESET}"
    printf "%b%s\n\n" "${MSG[assign_instructions]}"
}



# ───── Reset Input Subsystem ──────────────────────────────────────

reset_input_subsystem() {

    # Localized Output: Preparing
    printf "%b%b%s\n" "${INDICATOR_INFO}" "${FORMATTING_RESET}" "${MSG[reset_preparing]}"

    # Localized Output: Sudo Hint
    printf "  %b\n" "${MSG[reset_sudo_hint]}"

    # Reset Execution
    # We use sudo explicitly here. If run from a shortcut without a terminal, 
    # this will fail safely unless passwordless sudo is configured.
    if sudo udevadm trigger -s input; then
        printf "\n%b%b%s\n\n" "${INDICATOR_PASS}" "${FORMATTING_RESET}" "${MSG[reset_success]}"
    else
        printf "\n%b%b%s\n\n" "${INDICATOR_FAIL}" "${FORMATTING_RESET}" "${MSG[reset_fail]}"
        exit 1
    fi
}



# ───── Display Status and Config Information ──────────────────────

display_info() {

    check_state
    check_shortcut

    printf "\n%b\n" "${MSG[info_invoke]}"
    printf "├ $INFO_PAD %s %b%b%b\n" "--assign" "${MSG[info_desc_assign]}" "${FORMATTING_BOLD}" "${KEY_BINDING}" "${FORMATTING_RESET}"
    printf "├ $INFO_PAD %s%b\n" "--help" "${MSG[info_desc_help]}"
    printf "├ $INFO_PAD %s%b\n" "--reset" "${MSG[info_desc_reset]}"  
    printf "├ $INFO_PAD %s%b\n" "--toggle" "${MSG[info_desc_toggle]}"
    printf "├ $INFO_PAD %s%b\n" "--unassign" "${MSG[info_desc_remove]}"
    printf "╰ $INFO_PAD %s%b\n\n" "--watch" "${MSG[info_opt_watch]}"
    printf "  $INFO_PAD %b%b\n\n" "${MSG[info_path]}" "${SCRIPT_PATH}"    
}



# ───── Watch Script ─────────────────────────────────────────────

watch_script() {
    printf "${MSG[watch_start]}"
    watch --no-wrap --color --interval "$WATCH_INTERVAL" "$SCRIPT_PATH"
    printf "${MSG[watch_stop]}"
}



# ───── Main Logic Execution ───────────────────────────────────────

check_dependencies
show_header

# Check which option is provided

case "$1" in
    --assign)    assign_shortcut     ;;
    --help)        show_help ;;
    --reset)    reset_input_subsystem ;;
    --toggle)    toggle_touchpad     ;;
    --unassign)    remove_shortcut     ;;
    --watch)    watch_script ;;
    *)            display_info
esac

exit 0

# End of script
